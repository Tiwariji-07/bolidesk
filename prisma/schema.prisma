generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  INVOICED
}

/** OVERDUE and part-paid are derived from due date and balance, never stored. */
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CREDITED
}

enum GstScheme {
  REGULAR
  COMPOSITION
  UNREGISTERED
}

enum GstRateProfile {
  REFORM_2025
  LEGACY_2017
}

enum BillingDocumentType {
  TAX_INVOICE
  BILL_OF_SUPPLY
}

enum DocumentKind {
  INVOICE
  QUOTE
  RECEIPT
  CREDIT_NOTE
}

enum FollowUpStatus {
  OPEN
  SNOOZED
  DONE
}

enum PaymentProvider {
  DEMO
  RAZORPAY
}

enum JobStatus {
  OPEN
  SCHEDULED
  DONE
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK
  RAZORPAY
}

enum PaymentSource {
  MANUAL
  RAZORPAY
  LEGACY
}

/** Ledger rows are immutable: corrections are a REVERSAL of a receipt, money returned is a REFUND. */
enum PaymentEntryKind {
  RECEIPT
  REVERSAL
  REFUND
}

/** PENDING: reserved, provider call in progress or uncertain. CANCELLING: stale, provider cancel not yet confirmed. */
enum PaymentRequestStatus {
  PENDING
  ACTIVE
  CANCELLING
  PAID
  CANCELLED
  EXPIRED
  FAILED
}

enum DeliveryChannel {
  WHATSAPP
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String?
  passwordHash   String
  memberships    Membership[]
  invitesCreated WorkspaceInvite[] @relation("InvitesCreated")
  activities     Activity[]
  payments       Payment[]
  jobsAssigned   Job[]             @relation("JobsAssigned")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(MEMBER)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions    Session[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

/** Opaque server-side session: logout, removal and role changes revoke it. Only the token hash is stored. */
model Session {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([membershipId, expiresAt])
}

/** Owner-issued invite link. Only the token hash is stored; OWNER cannot be invited. */
model WorkspaceInvite {
  id              String         @id @default(cuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String
  role            MembershipRole
  tokenHash       String         @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdBy       User           @relation("InvitesCreated", fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())

  @@unique([workspaceId, email])
}

model Workspace {
  id            String     @id @default(cuid())
  name          String
  brandName     String
  /** 1–3 characters; frozen once a numbered document exists. */
  invoicePrefix String     @default("BD")
  legalName     String?
  address       String?
  /** Two-digit GST state code, e.g. "29" for Karnataka. */
  stateCode     String?
  gstScheme     GstScheme?
  gstRateProfile GstRateProfile @default(REFORM_2025)
  /** Used when a job note does not say the GST rate. */
  defaultTaxRate Float     @default(18)
  /** SAC/HSN prefilled on new lines, e.g. 998719 for repair and maintenance. */
  defaultCode   String?
  /** Shown on invoices for direct UPI payment. */
  upiId         String?
  gstin         String?
  counters      DocumentCounter[]
  memberships   Membership[]
  invites       WorkspaceInvite[]
  customers     Customer[]
  jobs          Job[]
  quotes        Quote[]
  invoices      Invoice[]
  followUps     FollowUp[]
  activities    Activity[]
  paymentRequests PaymentRequest[]
  payments      Payment[]
  creditNotes   CreditNote[]
  deliveryLogs  DeliveryLog[]
  portalTokens  CustomerPortalToken[]
  createdAt     DateTime   @default(now())
}

model Customer {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /** Normalized, e.g. +919876543210. */
  phone       String
  email       String?
  address     String?
  stateCode   String?
  gstin       String?
  jobs        Job[]
  quotes      Quote[]
  invoices    Invoice[]
  portalTokens CustomerPortalToken[]
  deliveryLogs DeliveryLog[]
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
  @@unique([workspaceId, phone])
}

model Job {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  note        String
  parsedJson  Json?
  status      JobStatus @default(OPEN)
  /** The technician doing the visit. */
  assigneeUserId String?
  assignee    User?     @relation("JobsAssigned", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  scheduledAt DateTime?
  doneAt      DateTime?
  quote       Quote?
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
  @@index([workspaceId, assigneeUserId, status])
}

model Quote {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  jobId       String?     @unique
  job         Job?        @relation(fields: [jobId], references: [id])
  /** Allocated when the quote is first sent. */
  number      String?
  status      QuoteStatus @default(DRAFT)
  /** Optimistic lock for draft edits. */
  version     Int         @default(0)
  subtotalPaise Int
  taxPaise    Int
  totalPaise  Int
  /** DocumentLine[] (paise prices). */
  linesJson   Json
  placeOfSupply String?
  dueDate     DateTime?   @db.Date
  createdAt   DateTime    @default(now())
  invoice     Invoice?
  portalTokens CustomerPortalToken[]
  @@unique([workspaceId, number])
  @@index([workspaceId, status])
}

model Invoice {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  quoteId     String?       @unique
  quote       Quote?        @relation(fields: [quoteId], references: [id])
  /** Allocated when the invoice is issued (Rule 46 series per financial year). */
  number      String?
  status      InvoiceStatus @default(DRAFT)
  version     Int           @default(0)
  documentType BillingDocumentType?
  subtotalPaise Int
  cgstPaise   Int           @default(0)
  sgstPaise   Int           @default(0)
  igstPaise   Int           @default(0)
  taxPaise    Int
  totalPaise  Int
  /** DocumentLine[] while a draft; CalculatedLine[] once issued. */
  linesJson   Json
  placeOfSupply String?
  paymentTerms String?
  dueDate     DateTime?     @db.Date
  issueDate   DateTime?     @db.Date
  issuedAt    DateTime?
  issuedByUserId String?
  /** Seller and buyer identity frozen at issue; later edits to settings or the customer do not change an issued invoice. */
  sellerSnapshot Json?
  buyerSnapshot Json?
  paidAt      DateTime?
  creditNote  CreditNote?
  followUp    FollowUp?
  payments    Payment[]
  paymentRequests PaymentRequest[]
  deliveryLogs DeliveryLog[]
  portalTokens CustomerPortalToken[]
  createdAt   DateTime      @default(now())
  @@unique([workspaceId, number])
  @@index([workspaceId, status])
}

/**
 * Cancels an issued invoice in full: its own Rule 46 series, the invoice's exact amounts and tax heads reversed,
 * and the invoice's frozen seller/buyer details. Partial credit notes are not supported yet.
 */
model CreditNote {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId      String    @unique
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: NoAction)
  number         String
  reason         String
  linesJson      Json
  subtotalPaise  Int
  cgstPaise      Int
  sgstPaise      Int
  igstPaise      Int
  taxPaise       Int
  totalPaise     Int
  issueDate      DateTime  @db.Date
  issuedAt       DateTime  @default(now())
  issuedByUserId String
  createdAt      DateTime  @default(now())

  @@unique([workspaceId, number])
}

/** Atomic per-workspace, per-kind, per-financial-year sequence. */
model DocumentCounter {
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind          DocumentKind
  financialYear String
  lastValue     Int

  @@id([workspaceId, kind, financialYear])
}

model FollowUp {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /** Set for the automatic "invoice overdue" follow-up; unique, so it is created once per invoice. */
  invoiceId   String?        @unique
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  subject     String
  action      String
  status      FollowUpStatus @default(OPEN)
  dueAt       DateTime
  snoozedUntil DateTime?
  /** Closed by a payment rather than by a person; reopened if the invoice becomes overdue again. */
  completedAutomatically Boolean @default(false)
  createdAt   DateTime       @default(now())
  @@index([workspaceId, status, dueAt])
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /** Null for webhooks and automatic work. */
  actorUserId String?
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  body        String
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
}

/** A payment link. At most one PENDING/ACTIVE/CANCELLING request per invoice (partial unique index in SQL). */
model PaymentRequest {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /** Sent to the provider as reference_id; retries of an uncertain attempt reuse it. */
  reference   String   @unique
  provider    PaymentProvider @default(DEMO)
  status      PaymentRequestStatus @default(PENDING)
  providerPaymentLinkId String? @unique
  amountPaise Int
  /** Provider's payable URL. Never a customer-portal URL (those carry a bearer token). */
  url         String?
  expiresAt   DateTime?
  lastError   String?
  createdByUserId String?
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([workspaceId, invoiceId])
}

model Payment {
  id               String           @id @default(cuid())
  workspaceId      String
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId        String
  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: NoAction)
  paymentRequestId String?
  paymentRequest   PaymentRequest?  @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  entryKind        PaymentEntryKind @default(RECEIPT)
  source           PaymentSource
  /** Positive for receipts, negative for reversals and refunds. */
  amountPaise      Int
  method           PaymentMethod?
  reference        String?
  receiptNumber    String?
  idempotencyKey   String
  providerPaymentId String?         @unique
  reversesPaymentId String?         @unique
  reversesPayment  Payment?         @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: NoAction)
  reversal         Payment?         @relation("PaymentReversal")
  recordedByUserId String?
  recordedBy       User?            @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  reason           String?
  occurredAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())

  @@unique([workspaceId, receiptNumber])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, invoiceId])
  @@index([workspaceId, occurredAt])
}

model DeliveryLog {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceId   String?
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  channel     DeliveryChannel
  provider    String
  recipient   String
  template    String?
  payloadJson Json
  status      DeliveryStatus
  providerMessageId String?   @unique
  /** invoice | reminder; used to stop a double tap sending twice. */
  purpose     String?
  error       String?
  createdAt   DateTime       @default(now())
  sentAt      DateTime?
  @@index([workspaceId, createdAt])
  @@index([invoiceId, createdAt])
}

model CustomerPortalToken {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quoteId     String?
  quote       Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastAccessedAt DateTime?
  createdAt   DateTime  @default(now())
  @@index([workspaceId, customerId])
  @@index([invoiceId])
  @@index([quoteId])
}
