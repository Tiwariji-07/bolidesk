generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

enum FollowUpStatus {
  OPEN
  SNOOZED
  DONE
}

enum PaymentProvider {
  DEMO
  RAZORPAY
}

enum DeliveryChannel {
  WHATSAPP
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(MEMBER)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Workspace {
  id            String     @id @default(cuid())
  name          String
  brandName     String
  invoicePrefix String     @default("BD")
  gstin         String?
  memberships   Membership[]
  customers     Customer[]
  jobs          Job[]
  quotes        Quote[]
  invoices      Invoice[]
  followUps     FollowUp[]
  activities    Activity[]
  paymentRequests PaymentRequest[]
  deliveryLogs  DeliveryLog[]
  portalTokens  CustomerPortalToken[]
  createdAt     DateTime   @default(now())
}

model Customer {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  email       String?
  address     String?
  jobs        Job[]
  quotes      Quote[]
  invoices    Invoice[]
  portalTokens CustomerPortalToken[]
  deliveryLogs DeliveryLog[]
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
  @@unique([workspaceId, phone])
}

model Job {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  note        String
  parsedJson  Json?
  quote       Quote?
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
}

model Quote {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  jobId       String?     @unique
  job         Job?        @relation(fields: [jobId], references: [id])
  number      String
  status      QuoteStatus @default(DRAFT)
  subtotal    Int
  tax         Int
  total       Int
  linesJson   Json
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  invoice     Invoice?
  portalTokens CustomerPortalToken[]
  @@unique([workspaceId, number])
  @@index([workspaceId, status])
}

model Invoice {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  quoteId     String?       @unique
  quote       Quote?        @relation(fields: [quoteId], references: [id])
  number      String
  status      InvoiceStatus @default(DRAFT)
  subtotal    Int
  tax         Int
  total       Int
  paidAt      DateTime?
  dueDate     DateTime?
  linesJson   Json
  paymentUrl  String?
  paymentRequests PaymentRequest[]
  deliveryLogs DeliveryLog[]
  portalTokens CustomerPortalToken[]
  createdAt   DateTime      @default(now())
  @@unique([workspaceId, number])
  @@index([workspaceId, status])
}

model FollowUp {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject     String
  action      String
  status      FollowUpStatus @default(OPEN)
  dueAt       DateTime
  snoozedUntil DateTime?
  createdAt   DateTime       @default(now())
  @@index([workspaceId, status, dueAt])
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
}

model PaymentRequest {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reference   String   @unique
  provider    PaymentProvider @default(DEMO)
  providerPaymentLinkId String? @unique
  amount      Int
  url         String
  createdAt   DateTime @default(now())
  @@index([workspaceId, invoiceId])
}

model DeliveryLog {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceId   String?
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  channel     DeliveryChannel
  provider    String
  recipient   String
  template    String?
  payloadJson Json
  status      DeliveryStatus
  providerMessageId String?
  error       String?
  createdAt   DateTime       @default(now())
  sentAt      DateTime?
  @@index([workspaceId, createdAt])
  @@index([invoiceId, createdAt])
}

model CustomerPortalToken {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quoteId     String?
  quote       Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastAccessedAt DateTime?
  createdAt   DateTime  @default(now())
  @@index([workspaceId, customerId])
  @@index([invoiceId])
  @@index([quoteId])
}
