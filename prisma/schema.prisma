generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  INVOICED
}

/** OVERDUE and part-paid are derived from due date and balance, never stored. */
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CREDITED
}

enum GstScheme {
  REGULAR
  COMPOSITION
  UNREGISTERED
}

enum GstRateProfile {
  REFORM_2025
  LEGACY_2017
}

enum BillingDocumentType {
  TAX_INVOICE
  BILL_OF_SUPPLY
}

enum DocumentKind {
  INVOICE
  QUOTE
  RECEIPT
  CREDIT_NOTE
}

enum FollowUpStatus {
  OPEN
  SNOOZED
  DONE
}

enum PaymentProvider {
  DEMO
  RAZORPAY
}

enum DeliveryChannel {
  WHATSAPP
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String?
  passwordHash   String
  memberships    Membership[]
  invitesCreated WorkspaceInvite[] @relation("InvitesCreated")
  activities     Activity[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(MEMBER)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions    Session[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

/** Opaque server-side session: logout, removal and role changes revoke it. Only the token hash is stored. */
model Session {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([membershipId, expiresAt])
}

/** Owner-issued invite link. Only the token hash is stored; OWNER cannot be invited. */
model WorkspaceInvite {
  id              String         @id @default(cuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String
  role            MembershipRole
  tokenHash       String         @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdBy       User           @relation("InvitesCreated", fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())

  @@unique([workspaceId, email])
}

model Workspace {
  id            String     @id @default(cuid())
  name          String
  brandName     String
  /** 1–3 characters; frozen once a numbered document exists. */
  invoicePrefix String     @default("BD")
  legalName     String?
  address       String?
  /** Two-digit GST state code, e.g. "29" for Karnataka. */
  stateCode     String?
  gstScheme     GstScheme?
  gstRateProfile GstRateProfile @default(REFORM_2025)
  /** Used when a job note does not say the GST rate. */
  defaultTaxRate Float     @default(18)
  /** SAC/HSN prefilled on new lines, e.g. 998719 for repair and maintenance. */
  defaultCode   String?
  /** Shown on invoices for direct UPI payment. */
  upiId         String?
  gstin         String?
  counters      DocumentCounter[]
  memberships   Membership[]
  invites       WorkspaceInvite[]
  customers     Customer[]
  jobs          Job[]
  quotes        Quote[]
  invoices      Invoice[]
  followUps     FollowUp[]
  activities    Activity[]
  paymentRequests PaymentRequest[]
  deliveryLogs  DeliveryLog[]
  portalTokens  CustomerPortalToken[]
  createdAt     DateTime   @default(now())
}

model Customer {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /** Normalized, e.g. +919876543210. */
  phone       String
  email       String?
  address     String?
  stateCode   String?
  gstin       String?
  jobs        Job[]
  quotes      Quote[]
  invoices    Invoice[]
  portalTokens CustomerPortalToken[]
  deliveryLogs DeliveryLog[]
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
  @@unique([workspaceId, phone])
}

model Job {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  note        String
  parsedJson  Json?
  quote       Quote?
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
}

model Quote {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  jobId       String?     @unique
  job         Job?        @relation(fields: [jobId], references: [id])
  /** Allocated when the quote is first sent. */
  number      String?
  status      QuoteStatus @default(DRAFT)
  /** Optimistic lock for draft edits. */
  version     Int         @default(0)
  subtotalPaise Int
  taxPaise    Int
  totalPaise  Int
  /** DocumentLine[] (paise prices). */
  linesJson   Json
  placeOfSupply String?
  dueDate     DateTime?   @db.Date
  createdAt   DateTime    @default(now())
  invoice     Invoice?
  portalTokens CustomerPortalToken[]
  @@unique([workspaceId, number])
  @@index([workspaceId, status])
}

model Invoice {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  quoteId     String?       @unique
  quote       Quote?        @relation(fields: [quoteId], references: [id])
  /** Allocated when the invoice is issued (Rule 46 series per financial year). */
  number      String?
  status      InvoiceStatus @default(DRAFT)
  version     Int           @default(0)
  documentType BillingDocumentType?
  subtotalPaise Int
  cgstPaise   Int           @default(0)
  sgstPaise   Int           @default(0)
  igstPaise   Int           @default(0)
  taxPaise    Int
  totalPaise  Int
  /** DocumentLine[] while a draft; CalculatedLine[] once issued. */
  linesJson   Json
  placeOfSupply String?
  paymentTerms String?
  dueDate     DateTime?     @db.Date
  issueDate   DateTime?     @db.Date
  issuedAt    DateTime?
  issuedByUserId String?
  /** Seller and buyer identity frozen at issue; later edits to settings or the customer do not change an issued invoice. */
  sellerSnapshot Json?
  buyerSnapshot Json?
  paidAt      DateTime?
  paymentUrl  String?
  paymentRequests PaymentRequest[]
  deliveryLogs DeliveryLog[]
  portalTokens CustomerPortalToken[]
  createdAt   DateTime      @default(now())
  @@unique([workspaceId, number])
  @@index([workspaceId, status])
}

/** Atomic per-workspace, per-kind, per-financial-year sequence. */
model DocumentCounter {
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind          DocumentKind
  financialYear String
  lastValue     Int

  @@id([workspaceId, kind, financialYear])
}

model FollowUp {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject     String
  action      String
  status      FollowUpStatus @default(OPEN)
  dueAt       DateTime
  snoozedUntil DateTime?
  createdAt   DateTime       @default(now())
  @@index([workspaceId, status, dueAt])
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /** Null for webhooks and automatic work. */
  actorUserId String?
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  body        String
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
}

model PaymentRequest {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reference   String   @unique
  provider    PaymentProvider @default(DEMO)
  providerPaymentLinkId String? @unique
  amount      Int
  url         String
  createdAt   DateTime @default(now())
  @@index([workspaceId, invoiceId])
}

model DeliveryLog {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceId   String?
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  channel     DeliveryChannel
  provider    String
  recipient   String
  template    String?
  payloadJson Json
  status      DeliveryStatus
  providerMessageId String?
  error       String?
  createdAt   DateTime       @default(now())
  sentAt      DateTime?
  @@index([workspaceId, createdAt])
  @@index([invoiceId, createdAt])
}

model CustomerPortalToken {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quoteId     String?
  quote       Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastAccessedAt DateTime?
  createdAt   DateTime  @default(now())
  @@index([workspaceId, customerId])
  @@index([invoiceId])
  @@index([quoteId])
}
