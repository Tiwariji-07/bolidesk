# Required for Docker Compose and Prisma migrations
DATABASE_URL="postgresql://bolidesk:bolidesk@127.0.0.1:5433/bolidesk?schema=public"

# Leave DEMO_MODE=true for a credential-free local workspace.
DEMO_MODE=true

# Public canonical URL; required when DEMO_MODE=false and used in payment callbacks.
APP_URL=http://localhost:3000

# Tomorrow: WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v22.0

# Tomorrow: Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Tomorrow: AI parser provider
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
