# Required for Docker Compose and Prisma migrations
DATABASE_URL="postgresql://bolidesk:bolidesk@127.0.0.1:5433/bolidesk?schema=public"

# Auth: use a unique random value (at least 32 characters) for every environment.
SESSION_SECRET=
# Demo seed identity. Set DEMO_USER_PASSWORD locally before `npm run db:seed`; never commit it.
DEMO_USER_EMAIL=demo@bolidesk.local
DEMO_USER_PASSWORD=

# Set true only on a server that should let anyone create a new shop workspace.
ALLOW_REGISTRATION=false

# Leave DEMO_MODE=true for a credential-free local workspace.
DEMO_MODE=true

# Public canonical URL; required when DEMO_MODE=false and used in payment callbacks.
APP_URL=http://localhost:3000

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Approved templates; body {{1}} customer, {{2}} shop, {{3}} invoice no., {{4}} amount, {{5}} link
WHATSAPP_TEMPLATE_INVOICE=invoice_ready
WHATSAPP_TEMPLATE_REMINDER=payment_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v22.0

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI note reader
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Throwaway database for `npm run test:db` (it is wiped on every run).
TEST_DATABASE_URL="postgresql://bolidesk:bolidesk@127.0.0.1:5433/bolidesk_test?schema=public"
